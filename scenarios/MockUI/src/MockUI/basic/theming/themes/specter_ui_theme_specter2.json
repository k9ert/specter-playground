{
  "_metadata": {
    "name": "Specter2",
    "version": "1.0",
    "description": "Console theme for Specter UI"
  },
  "colors": {
    "PRIMARY":    "#00D100",
    "SECONDARY":  "#FFFFFF",
    "TERTIARY":   "#FFFFFF",
    "QUATERNARY": "#FFFFFF",
    "NEUTRAL":    "#777777",
    "SUCCESS":    "#00D100",
    "WARNING":    "#D17700",
    "DANGER":     "#D10000",
    "CANVAS":     "#000000",
    "INK":        "#00D100"
  },
  "fonts": {
    "TITLE": "unscii:16",
    "TEXT":  "unscii:16",
    "SMALL": "unscii:8"
  },
  "styles": {
    "CONTAINER.SCREEN":           { "style": ["@APPEARANCE.VISIBLE", "@LAYOUT.BARE", "@BG.DARK"], "layout": "FLEX", "flex_flow": "COLUMN" },
    "CONTAINER.NAVBAR":           { "style": ["@APPEARANCE.VISIBLE", "@LAYOUT.BARE", "@BG.DEFAULT", "@BORDER.TOP"], "radius": 0, "border_width": 0,"border_color": "@INK", "clip_corner": "True", "width": "pct(100)", "height": "pct(8)"},
    "CONTAINER.CONTENT":          { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL", "@LAYOUT.GROWS"], "width": "pct(100)" },
    "CONTAINER.MAIN_MENU":        {},
    "CONTAINER.TITLED_SCREEN":    { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL", "@LAYOUT.GROWS"], "width": "pct(100)", "flex_main_place": "START"},
    "CONTAINER.MENU_CONTAINER":   { "pad_left": 20, "pad_right": 20, "pad_row": 10 },
    "CONTAINER.MENU_ROW":         { "pad_left": 20, "pad_right": 20, "pad_row": 10 },
    "CONTAINER.MENU_BUTTON_RHS":  { "pad_left": 20, "pad_right": 20, "pad_row": 10 },
    "CONTAINER.CONTEXT_BAR":      { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@FG.DEFAULT"], "pad_column": 5 },
    "CONTAINER.DROPUP":           { "style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT", "@BG.DEFAULT", "@TEXT.TITLE"], "radius": 0, "border_width":1, "border_color": "@SECONDARY" },
    "CONTAINER.DROP_UP_ROW":      { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE"], "pad_left": 20, "pad_right": 20, "pad_column": 5, "pad_top": 2, "pad_bottom": 10 },
    "CONTAINER.INTERFACE_STATUS": {},
    "CONTAINER.MODAL_WINDOW":     { "style": ["@APPEARANCE.VISIBLE", "@BG.DEFAULT", "@FG.DEFAULT"], "border_width": 1, "radius": 0, "border_color": "@INK", "pad_all": 20 },    
    "CONTAINER.TITLE_BAR":        { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_ROW"], "flex_main_place": "CENTER", "width": "pct(100)", "height": "pct(8)"},
    "CONTAINER.APP_SCREEN":       { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE"], "layout": "FLEX", "flex_flow": "COLUMN", "flex_grow": 1, "width": "pct(100)" },
    "CONTAINER.PIN_SCREEN":       { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL"], "flex_cross_place": "CENTER", "width": "pct(100)" },
    "CONTAINER.PIN_BUTTON_ROW":   { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_ROW"], "flex_main_place": "SPACE_EVENLY", "flex_cross_place": "CENTER", "width": "pct(80)", "height": "SIZE_CONTENT" },
    "CONTAINER.BATTERY":          { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE"], "align": "TOP_RIGHT", "width": 50, "height": 64 },
    "WIDGET.SCREEN_TITLE":        { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE", "@TEXT.CENTER"] },
    "WIDGET.OVERLAY":             { "style": ["@LAYOUT.BARE", "@BG.DARK", "@APPEARANCE.SEE_THROUGH"]},
    "WIDGET.NAVBAR_BUTTON":       { "style": ["@APPEARANCE.TRANSPARENT"] },
    "WIDGET.NAVBAR_BUTTON_FG":    { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT"] },
    "WIDGET.BUTTON":              { "style": ["@APPEARANCE.VISIBLE", "@BG.DEFAULT"], "border_width": 1, "border_color": "@INK", "radius": 0 },    
    "WIDGET.BUTTON_FG":           { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE"] },
    "WIDGET.TEXT_EDIT":           { "style": ["@APPEARANCE.VISIBLE", "@TEXT.CENTER", "@FG.DEFAULT", "@BG.DEFAULT"], "border_width": 1, "border_color": "@INK", "pad_top": 0, "pad_bottom": 0},
    "WIDGET.INFO_ITEM":           { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.SMALL"], "text_align": "CENTER" },
    "WIDGET.HELP_ICON":           { "style": ["@APPEARANCE.TRANSPARENT", "@FG.LIGHT"] },
    "WIDGET.MENU_SECTION_HEADER": { "style": ["@APPEARANCE.TRANSPARENT", "@FG.HIGHLIGHT", "@TEXT.DEFAULT", "@TEXT.LEFT"], "pad_top": 6, "pad_bottom": 3, "pad_left": 0 },
    "WIDGET.MENU_BUTTON":         { "style": ["@APPEARANCE.VISIBLE", "@BG.DEFAULT"], "border_width": 1, "border_color": "@INK", "radius": 0 },
    "WIDGET.MENU_BUTTON_FG":      { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.DEFAULT"] },
    "WIDGET.MENU_ICON":           { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT"], "bg_color": "@CANVAS", "align": "LEFT_MID", "x": 10, "radius": 0, "border_width": 0, "width": 55, "height": 55 },
    "WIDGET.MENU_SWITCH":         { "style": ["@APPEARANCE.VISIBLE", "@BG.DEFAULT", "@FG.DEFAULT", "@TEXT.DEFAULT"], "pad_gap": 10, "pad_left": 10 },
    "WIDGET.SUBMENU_INDICATOR":   { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT"] },
    "WIDGET.DROP_UP_ADDBTN":      { "style": ["@APPEARANCE.VISIBLE", "@BG.DEFAULT"], "width":"478", "border_width": 1, "border_color": "@INK", "radius": 0, "height": 60 },
    "WIDGET.DROP_UP_ADDBTN_FG":   { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.DEFAULT"] },    
    "WIDGET.KEYBOARD":            { "style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT", "@BG.DARK", "@TEXT.TITLE"], "border_width": 1, "border_color": "@SECONDARY", "radius": 0},
    "WIDGET.BATTERY":             {},
    "WIDGET.PIN_BUTTON":          { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BORDERLESS", "@FG.DEFAULT", "@TEXT.TITLE"] },
    "WIDGET.PIN_BUTTON_FG":       {},
    "WIDGET.PIN_DISPLAY":         { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE", "@TEXT.CENTER"]},
    "WIDGET.DELETE_BUTTON":       {},
    "WIDGET.DELETE_BUTTON_FG":    {},
    "TEXT.DEFAULT":               { "text_font": "@TEXT" },
    "TEXT.TITLE":                 { "text_font": "@TITLE"},
    "TEXT.SMALL":                 { "text_font": "@SMALL"},
    "TEXT.LEFT":                  { "text_align": "LEFT" },
    "TEXT.CENTER":                { "text_align": "CENTER" },
    "TEXT.RIGHT":                 { "text_align": "RIGHT" },
    "TEXT.BODY":                  {  },
    "LAYOUT.BARE":                { "border_width": 0, "radius": 0, "pad_all": 0 },
    "LAYOUT.BORDERLESS":          { "border_width": 0 },
    "LAYOUT.GROWS":               { "flex_grow": 1 },
    "LAYOUT.FLEX_COL":            { "layout": "FLEX", "flex_flow": "COLUMN" },
    "LAYOUT.FLEX_ROW":            { "layout": "FLEX", "flex_flow": "ROW" }, 
    "LAYOUT.FULL_SIZE":           {  "width" : "pct(100)", "height": "pct(100)"}, 
    "APPEARANCE.VISIBLE":         { "opa": "COVER" , "bg_opa": "COVER" },
    "APPEARANCE.TRANSPARENT":     { "opa": "COVER",  "bg_opa": "TRANSP" },
    "APPEARANCE.INVISIBLE":       { "opa": "TRANSP", "bg_opa": "TRANSP" },
    "APPEARANCE.SEE_THROUGH":     { "opa": "COVER", "bg_opa": "_70" },
    "FG.DEFAULT":                 { "text_color": "@INK", "image_recolor": "@INK"},
    "FG.SUCCESS":                 { "text_color": "@SUCCESS", "image_recolor": "@SUCCESS"},
    "FG.WARNING":                 { "text_color": "@WARNING", "image_recolor": "@WARNING"},
    "FG.DANGER":                  { "text_color": "@DANGER", "image_recolor": "@DANGER"},
    "FG.HIGHLIGHT":               { "text_color": "@SECONDARY", "image_recolor": "@SECONDARY"},
    "FG.LIGHT":                   { "text_color": "@NEUTRAL", "image_recolor": "@NEUTRAL"},
    "FG.DARK":                    { "text_color": "@CANVAS", "image_recolor": "@CANVAS"},
    "BG.DEFAULT":                 { "bg_color": "@CANVAS"},
    "BG.SUCCESS":                 { "bg_color": "@SUCCESS"},
    "BG.WARNING":                 { "bg_color": "@WARNING"},
    "BG.DANGER":                  { "bg_color": "@DANGER"},
    "BG.HIGHLIGHT":               { "bg_color": "@SECONDARY"},
    "BG.LIGHT":                   { "bg_color": "@SECONDARY"},
    "BG.DARK":                    { "bg_color": "@CANVAS"},
    "BORDER.TOP":                 { "border_width": 1, "border_side": "TOP",    "border_color": "@INK" },
    "BORDER.BOTTOM":              { "border_width": 1, "border_side": "BOTTOM", "border_color": "@INK" },
    "BORDER.LEFT":                { "border_width": 1, "border_side": "LEFT",   "border_color": "@INK" },
    "BORDER.RIGHT":               { "border_width": 1, "border_side": "RIGHT",  "border_color": "@INK" },
    "CONTEXT.SEED":               {},
    "CONTEXT.WALLET":             {},
    "CONTEXT.MAIN":               {},
    "CONTEXT.SETTINGS":           {},
    "SLIDER.TRACK":               {"style": ["@APPEARANCE.VISIBLE", "@BG.DARK"], "pad_all": 0, "radius": 0},
    "SLIDER.INDICATOR":           {"style": ["@APPEARANCE.VISIBLE", "@BG.WARNING"], "pad_all": 0, "radius": 0},
    "SLIDER.KNOB":                {"style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT"], "pad_all": -3, "radius": 0},
    "SWITCH.TRACK":               {"style": ["@APPEARANCE.VISIBLE", "@BG.DARK"], "pad_all": 0, "radius": 0},
    "SWITCH.INDICATOR":           {"style": ["@APPEARANCE.VISIBLE", "@BG.DARK"], "pad_all": 0, "radius": 0},
    "SWITCH.KNOB":                {"style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT"], "pad_all": -3, "radius": 0},
    "MODIFIER.MUTED":             {"text_color": "shade(@NEUTRAL, -5)", "image_recolor": "shade(@NEUTRAL, -5)" },
    "MODIFIER.CLICKED":           {"bg_color": "@SECONDARY", "bg_opa": "COVER"},
    "ANIM.HORIZONTAL":           { "anim_duration": 150 },
    "ANIM.VERTICAL":             { "anim_duration": 300 }
  }
}
