                                    "roles": { "FG": { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BORDERLESS", "@FG.DEFAULT", "@TEXT.TITLE"] } } },
    "WIDGET.PIN_DISPLAY":         { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE", "@TEXT.CENTER"] },
    "WIDGET.DELETE_BUTTON":       { "style": ["@APPEARANCE.VISIBLE", "@BG.DANGER", "@LAYOUT.FLEX_ROW", "@LAYOUT.ALL_CENTERED"], "width": 48, "height": 48, "radius": 0, "border_width": 1, "border_color": "@INK",
                                    "roles": { "FG": { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE"] } } },
    "WIDGET.MODAL_BODY":          { "style": ["@TEXT.BODY", "@TEXT.DEFAULT", "@TEXT.CENTER", "@LAYOUT.PARENT_WIDTH"] },
    "WIDGET.SLIDER":              { "style": ["@APPEARANCE.VISIBLE"],
                                    "roles": {
                                      "TRACK":     { "style": ["@APPEARANCE.VISIBLE", "@BG.DARK", "@LAYOUT.PARENT_WIDTH"], "height": 75, "pad_all": 0, "radius": 32767 },
                                      "INDICATOR": { "style": ["@APPEARANCE.VISIBLE", "@BG.WARNING"], "pad_all": 0, "radius": 32767 },
                                      "KNOB":      { "style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT"], "pad_all": -3, "radius": 32767 }
                                    } },
    "WIDGET.SWITCH":              { "style": ["@APPEARANCE.VISIBLE"],
                                    "roles": {
                                      "TRACK":     { "style": ["@APPEARANCE.VISIBLE", "@BG.HIGHLIGHT"], "pad_all": 0, "radius": 32767, "width": 80, "height": 45 },
                                      "INDICATOR": { "style": ["@APPEARANCE.VISIBLE", "@BG.HIGHLIGHT"], "pad_all": 0, "radius": 32767 },
                                      "KNOB":      { "style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT"], "pad_all": -3, "radius": 32767 }
                                    } },
    "WIDGET.TREE_CONNECTOR":      { "style": ["@APPEARANCE.TRANSPARENT"], "line_color": "@INK", "line_width": 1, "pad_left": 38, "pad_right": 12 },
    "WIDGET.TREE_EXPANDER":       { "style": ["@WIDGET.NAVBAR_BUTTON"], "width": 42, "height": 42,
                                    "roles": { "FG": { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT"] } } },
    "TEXT.DEFAULT":               { "text_font": "@TEXT" },
    "TEXT.TITLE":                 { "text_font": "@TITLE" },
    "TEXT.SMALL":                 { "text_font": "@SMALL" },
    "TEXT.LEFT":                  { "text_align": "LEFT" },
    "TEXT.CENTER":                { "text_align": "CENTER" },
    "TEXT.RIGHT":                 { "text_align": "RIGHT" },
    "TEXT.BODY":                  {},
    "LAYOUT.BARE":                { "border_width": 0, "radius": 0, "pad_all": 0 },
    "LAYOUT.BORDERLESS":          { "border_width": 0 },
    "LAYOUT.GROWS":               { "flex_grow": 1 },
    "LAYOUT.PARENT_WIDTH":        { "width": "pct(100)" },
    "LAYOUT.PARENT_HEIGHT":       { "height": "pct(100)" },
    "LAYOUT.FLEX_COL":            { "layout": "FLEX", "flex_flow": "COLUMN" },
    "LAYOUT.FLEX_ROW":            { "layout": "FLEX", "flex_flow": "ROW" },
    "LAYOUT.FULL_SIZE":           { "style": ["@LAYOUT.PARENT_WIDTH", "@LAYOUT.PARENT_HEIGHT"] },
    "LAYOUT.ALL_CENTERED":        { "flex_main_place": "CENTER", "flex_cross_place": "CENTER", "flex_track_place": "CENTER" },
    "LAYOUT.START":               { "flex_main_place": "START", "flex_cross_place": "CENTER", "flex_track_place": "CENTER" },
    "APPEARANCE.VISIBLE":         { "opa": "COVER", "bg_opa": "COVER" },
    "APPEARANCE.TRANSPARENT":     { "opa": "COVER", "bg_opa": "TRANSP" },
    "APPEARANCE.INVISIBLE":       { "opa": "TRANSP", "bg_opa": "TRANSP" },
    "APPEARANCE.SEE_THROUGH":     { "opa": "COVER", "bg_opa": "_70" },
    "FG.DEFAULT":                 { "text_color": "@INK", "image_recolor": "@INK" },
    "FG.SUCCESS":                 { "text_color": "@SUCCESS", "image_recolor": "@SUCCESS" },
    "FG.WARNING":                 { "text_color": "@WARNING", "image_recolor": "@WARNING" },
    "FG.DANGER":                  { "text_color": "@DANGER", "image_recolor": "@DANGER" },
    "FG.HIGHLIGHT":               { "text_color": "@SECONDARY", "image_recolor": "@SECONDARY" },
    "FG.LIGHT":                   { "text_color": "@NEUTRAL", "image_recolor": "@NEUTRAL" },
    "FG.DARK":                    { "text_color": "@TERTIARY", "image_recolor": "@TERTIARY" },
    "BG.DEFAULT":                 { "bg_color": "@QUATERNARY" },
    "BG.SUCCESS":                 { "bg_color": "@SUCCESS" },
    "BG.WARNING":                 { "bg_color": "@WARNING" },
    "BG.DANGER":                  { "bg_color": "@DANGER" },
    "BG.HIGHLIGHT":               { "bg_color": "@PRIMARY" },
    "BG.LIGHT":                   { "bg_color": "@QUATERNARY" },
    "BG.DARK":                    { "bg_color": "@CANVAS" },
    "BORDER.TOP":                 { "border_width": 1, "border_side": "TOP", "border_color": "@TERTIARY" },
    "BORDER.BOTTOM":              { "border_width": 1, "border_side": "BOTTOM", "border_color": "@TERTIARY" },
    "BORDER.LEFT":                { "border_width": 1, "border_side": "LEFT", "border_color": "@TERTIARY" },
    "BORDER.RIGHT":               { "border_width": 1, "border_side": "RIGHT", "border_color": "@TERTIARY" },
    "CONTEXT.SEED":               {},
    "CONTEXT.WALLET":             {},
    "CONTEXT.MAIN":               {},
    "CONTEXT.SETTINGS":           {},
    "MODIFIER.MUTED":             { "text_color": "shade(@NEUTRAL, -3)", "image_recolor": "shade(@NEUTRAL, -3)" },
    "MODIFIER.MUTED_BG":          { "bg_color": "shade(@NEUTRAL, -3)" },
    "MODIFIER.CLICKED":           { "bg_color": "@PRIMARY", "bg_opa": "COVER" },
    "ANIM.HORIZONTAL":            { "anim_duration": 150 },
    "ANIM.VERTICAL":              { "anim_duration": 300 }
  }
}