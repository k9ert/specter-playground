                                      "ICON":      { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT"], "radius": 0, "border_width": 1, "border_color": "@INK", "width": 44, "height": 44 },
                                      "LABEL":     { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.DEFAULT", "@TEXT.LEFT", "@LAYOUT.GROWS"], "pad_left": 12 },
                                      "INDICATOR": { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT"] },
                                      "RHS":       { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_ROW"], "width": "SIZE_CONTENT", "height": "SIZE_CONTENT", "flex_cross_place": "CENTER", "pad_left": 8, "pad_right": 8, "pad_column": 8 }
                                    } },
    "WIDGET.MENU_SWITCH":         { "style": ["@APPEARANCE.TRANSPARENT", "@BG.DEFAULT", "@FG.DEFAULT", "@TEXT.DEFAULT"], "pad_gap": 10, "pad_left": 10 },
