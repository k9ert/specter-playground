    "CONTAINER.DROPUP":           { "style": ["@APPEARANCE.VISIBLE", "@LAYOUT.PARENT_WIDTH", "@LAYOUT.FLEX_COL", "@LAYOUT.START", "@FG.DEFAULT", "@BG.DEFAULT", "@TEXT.TITLE"], "radius": 0, "border_width": 1, "border_color": "@INK", "pad_all": 16, "height": "SIZE_CONTENT" },
    "CONTAINER.DROP_UP_ROW":      { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.PARENT_WIDTH", "@LAYOUT.FLEX_ROW", "@FG.DEFAULT", "@TEXT.TITLE", "@LAYOUT.ALL_CENTERED", "@TEXT.LEFT"], "height": "SIZE_CONTENT", "pad_left": 10, "pad_right": 10, "pad_column": 5, "pad_top": 2, "pad_bottom": 10 },
    "CONTAINER.ADD_BUTTON_ROW":   { "style": ["@CONTAINER.DROP_UP_ROW"], "pad_left": 5, "pad_right": 5, "pad_column": 0 },
    "CONTAINER.APP_SCREEN":       { "style": ["@APPEARANCE.VISIBLE", "@BG.DARK", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL", "@LAYOUT.GROWS", "@LAYOUT.PARENT_WIDTH"] },
    "CONTAINER.BATTERY":          { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE"], "align": "TOP_RIGHT", "width": 50, "height": 50 },
    "CONTAINER.CONTEXT_BAR":      { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_ROW", "@FG.DEFAULT"], "height": "pct(8)", "align": "TOP_LEFT", "pad_column": 5 },
    "CONTAINER.INFO_CARD":        { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_ROW", "@LAYOUT.START", "@BG.DEFAULT", "@LAYOUT.FULL_SIZE"], "pad_column": 5 },
    "CONTAINER.CONTENT":          { "style": ["@APPEARANCE.VISIBLE", "@BG.DARK", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL", "@LAYOUT.START", "@LAYOUT.GROWS", "@LAYOUT.PARENT_WIDTH"] },
    "CONTAINER.TITLED_SCREEN":    { "style": ["@APPEARANCE.TRANSPARENT", "@BG.DARK", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL", "@LAYOUT.START", "@LAYOUT.GROWS", "@LAYOUT.PARENT_WIDTH"] },
    "CONTAINER.TITLE_BAR":        { "style": ["@APPEARANCE.VISIBLE", "@BG.DARK", "@LAYOUT.BARE", "@LAYOUT.FLEX_ROW", "@LAYOUT.PARENT_WIDTH", "@LAYOUT.ALL_CENTERED"], "height": "pct(10)" },
    "CONTAINER.MENU_CONTAINER":   { "style": ["@LAYOUT.FLEX_COL", "@LAYOUT.START", "@LAYOUT.GROWS", "@LAYOUT.BARE"], "pad_left": 20, "pad_right": 20, "pad_row": 10, "pad_bottom": 12 },
    "CONTAINER.MENU_ROW":         { "style": ["@LAYOUT.BARE", "@LAYOUT.FLEX_ROW", "@LAYOUT.START", "@LAYOUT.PARENT_WIDTH"], "height": "SIZE_CONTENT", "pad_left": 0, "pad_right": 0, "pad_column": 10 },
    "CONTAINER.MAIN_MENU":        {},
    "CONTAINER.INTERFACE_STATUS": { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_ROW", "@LAYOUT.ALL_CENTERED", "@LAYOUT.PARENT_WIDTH"], "height": "SIZE_CONTENT", "pad_column": 10 },
    "CONTAINER.PIN_SCREEN":       { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL", "@LAYOUT.PARENT_WIDTH", "@LAYOUT.ALL_CENTERED"] },
    "CONTAINER.PIN_BUTTON_ROW":   { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_ROW"], "flex_main_place": "SPACE_EVENLY", "flex_cross_place": "CENTER", "width": "pct(80)", "height": "SIZE_CONTENT" },
    "CONTAINER.MODAL_WINDOW":     { "style": ["@APPEARANCE.VISIBLE", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL", "@BG.DEFAULT", "@FG.DEFAULT"], "width": "pct(70)", "height": "SIZE_CONTENT", "border_width": 1, "radius": 0, "border_color": "@TERTIARY", "pad_all": 18, "pad_row": 10 },
    "CONTAINER.MODAL_BUTTON_ROW": { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_ROW", "@LAYOUT.PARENT_WIDTH"], "flex_main_place": "SPACE_EVENLY", "flex_cross_place": "CENTER", "height": "SIZE_CONTENT", "pad_top": 15 },
    "CONTAINER.FINGERPRINT_BADGE":{ "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_ROW", "@LAYOUT.START"], "width": 86, "height": "SIZE_CONTENT" },
