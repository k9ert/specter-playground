    "WIDGET.BUTTON":              { "style": ["@APPEARANCE.VISIBLE", "@BG.DEFAULT", "@LAYOUT.FLEX_ROW", "@LAYOUT.ALL_CENTERED"], "border_width": 1, "border_color": "@INK", "radius": 0, "height": 56, "pad_left": 16, "pad_right": 16, "pad_top": 10, "pad_bottom": 10,
                                    "roles": { "FG": { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.DEFAULT"] } } },
    "WIDGET.TEXT_EDIT":           { "style": ["@APPEARANCE.VISIBLE", "@TEXT.CENTER", "@FG.DEFAULT", "@BG.DEFAULT"], "border_width": 1, "border_color": "@TERTIARY", "radius": 12, "pad_top": 12, "pad_bottom": 12,
