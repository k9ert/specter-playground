{
  "_metadata": {
    "name": "Console",
    "version": "1.0",
    "description": "Console theme for Specter UI"
  },
  "colors": {
    "PRIMARY":    "#004D00",
    "SECONDARY":  "#00D100",
    "TERTIARY":   "#000000",
    "QUATERNARY": "#000000",
    "NEUTRAL":    "#008F00",
    "SUCCESS":    "#00D100",
    "WARNING":    "#D17700",
    "DANGER":     "#D10000",
    "CANVAS":     "#000000",
    "INK":        "#00D100"
  },
  "fonts": {
    "TITLE": "unscii:16",
    "TEXT":  "unscii:16",
    "SMALL": "unscii:8"
  },
  "styles": {
    "CONTAINER.SCREEN":           { "style": ["@APPEARANCE.VISIBLE", "@LAYOUT.BARE", "@BG.DARK", "@LAYOUT.FLEX_COL"], "flex_main_place": "START" },
