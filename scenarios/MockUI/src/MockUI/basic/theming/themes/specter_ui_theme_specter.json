{
  "_metadata": {
    "name": "Specter",
    "version": "1.0",
    "description": "Default theme for Specter UI"
  },
  "colors": {
    "primary":    "#f7931a",
    "secondary":  "#5c6bc0",
    "tertiary":   "#26a69a",
    "quaternary": "#9c27b0",
    "neutral":    "#777777",
    "success":    "#00D100",
    "warning":    "#FF9A00",
    "danger":     "#F10000",
    "canvas":    { "dark": "#282B30", "light": "#FFFFFF" },
    "ink":       { "dark": "#FFFFFF", "light": "#111111" }
  },
  "fonts": {
    "title": "montserrat:28",
    "text":  "montserrat:22",
    "small": "montserrat:16"
  },
  "styles": {
    "WIDGET.SCREEN":      { "bg_color": "@canvas",   "bg_opa": "COVER", "border_width": 0, "radius": 0, "pad_all": 0 },
    "WIDGET.NAVBAR":      { "bg_color": "@primary",  "bg_opa": "COVER", "border_width": 0, "radius": 0, "pad_all": 0 },
    "WIDGET.PANEL":       { "border_width": 0, "radius": 0, "pad_all": 0 },
    "WIDGET.CARD":        { "radius": 8, "border_width": 0, "pad_all": 12 },
    "WIDGET.OVERLAY":     { "bg_color": "@neutral",  "bg_opa": 180, "border_width": 0, "radius": 0, "pad_all": 0 },
    "WIDGET.BUTTON":      { "text_font": "@text" },
    "WIDGET.BUTTON_FLAT": { "bg_opa": "TRANSP", "shadow_width": 0, "border_width": 0 },
    "WIDGET.TEXT_INPUT":  { "border_width": 1, "border_color": "@ink", "text_font": "@text" },
    "LAYOUT.BARE":        { "border_width": 0, "radius": 0, "pad_all": 0, "bg_opa": "TRANSP" },
    "LAYOUT.TRANSPARENT": { "bg_opa": "TRANSP" },
    "LAYOUT.INVISIBLE":   { "opa": 0 },
    "LAYOUT.SEE_THROUGH": { "bg_opa": 180 },
    "TEXT.DEFAULT":       { "text_font": "@text",  "text_color": "@ink" },
    "TEXT.TITLE":         { "text_font": "@title" },
    "TEXT.SMALL":         { "text_font": "@small" },
    "FG.DEFAULT":         { "text_color": "@ink" },
    "FG.SUCCESS":         { "text_color": "@success" },
    "FG.WARNING":         { "text_color": "@warning" },
    "FG.DANGER":          { "text_color": "@danger" },
    "FG.HIGHLIGHT":       { "text_color": "@primary" },
    "FG.LIGHT":           { "text_color": "shade(@neutral, +8)" },
    "FG.DARK":            { "text_color": "shade(@neutral, -8)" },
    "BG.DEFAULT":         { "bg_color": "@canvas",  "bg_opa": "COVER" },
    "BG.SUCCESS":         { "bg_color": "@success", "bg_opa": "COVER" },
    "BG.WARNING":         { "bg_color": "@warning", "bg_opa": "COVER" },
    "BG.DANGER":          { "bg_color": "@danger",  "bg_opa": "COVER" },
    "BG.HIGHLIGHT":       { "bg_color": "@primary", "bg_opa": "COVER" },
    "BG.LIGHT":           { "bg_color": "shade(@neutral, +8)", "bg_opa": "COVER" },
    "BG.DARK":            { "bg_color": "shade(@neutral, -8)", "bg_opa": "COVER" },
    "BORDER.TOP":         { "border_width": 1, "border_side": "TOP",    "border_color": "@ink" },
    "BORDER.BOTTOM":      { "border_width": 1, "border_side": "BOTTOM", "border_color": "@ink", "border_opa": 200 },
    "BORDER.LEFT":        { "border_width": 1, "border_side": "LEFT",   "border_color": "@ink" },
    "BORDER.RIGHT":       { "border_width": 1, "border_side": "RIGHT",  "border_color": "@ink" },
    "SLIDER.TRACK":       { "bg_opa": "_30" },
    "SLIDER.INDICATOR":   { "bg_opa": "_70" },
    "SLIDER.KNOB":        { "bg_color": "@ink", "bg_opa": "COVER", "pad_all": 0 },
    "CONTEXT.SEED":       { },
    "CONTEXT.WALLET":     { },
    "CONTEXT.MAIN":       { },
    "CONTEXT.SETTINGS":   { },
    "MODIFIER.MUTED":     { "opa": 100 }
  }
}
