    "FG.SUCCESS":                 { "text_color": "@SUCCESS", "image_recolor": "@SUCCESS"},
    "FG.WARNING":                 { "text_color": "@WARNING", "image_recolor": "@WARNING"},
    "FG.DANGER":                  { "text_color": "@DANGER", "image_recolor": "@DANGER"},
    "FG.HIGHLIGHT":               { "text_color": "@PRIMARY", "image_recolor": "@PRIMARY"},
    "FG.LIGHT":                   { "text_color": "@NEUTRAL", "image_recolor": "@NEUTRAL"},
    "FG.DARK":                    { "text_color": "@TERTIARY", "image_recolor": "@TERTIARY"},
    "BG.DEFAULT":                 { "bg_color": "@CANVAS"},
    "BG.SUCCESS":                 { "bg_color": "@SUCCESS"},
    "BG.WARNING":                 { "bg_color": "@WARNING"},
    "BG.DANGER":                  { "bg_color": "@DANGER"},
    "BG.HIGHLIGHT":               { "bg_color": "@PRIMARY"},
    "BG.LIGHT":                   { "bg_color": "@NEUTRAL"},
    "BG.DARK":                    { "bg_color": "@TERTIARY"},
    "BORDER.TOP":                 { "border_width": 1, "border_side": "TOP",    "border_color": "@NEUTRAL" },
    "BORDER.BOTTOM":              { "border_width": 1, "border_side": "BOTTOM", "border_color": "@NEUTRAL" },
    "BORDER.LEFT":                { "border_width": 1, "border_side": "LEFT",   "border_color": "@NEUTRAL" },
    "BORDER.RIGHT":               { "border_width": 1, "border_side": "RIGHT",  "border_color": "@NEUTRAL" },
    "CONTEXT.SEED":               {},
    "CONTEXT.WALLET":             {},
    "CONTEXT.MAIN":               {},
    "CONTEXT.SETTINGS":           {},
    "SLIDER.TRACK":               {"style": ["@APPEARANCE.VISIBLE", "@BG.DARK", "@LAYOUT.PARENT_WIDTH"], "height": 75, "pad_all": 0, "radius": 32767},
    "SLIDER.INDICATOR":           {"style": ["@APPEARANCE.VISIBLE", "@BG.WARNING"], "pad_all": 0, "radius": 32767},
    "SLIDER.KNOB":                {"style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT"], "pad_all": -3, "radius": 32767},
    "SWITCH.TRACK":               {"style": ["@APPEARANCE.VISIBLE", "@BG.HIGHLIGHT"], "pad_all": 0, "radius": 32767, "width": 80, "height": 45},
    "SWITCH.INDICATOR":           {"style": ["@APPEARANCE.VISIBLE", "@BG.HIGHLIGHT"], "pad_all": 0, "radius": 32767},
    "SWITCH.KNOB":                {"style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT"], "pad_all": -3, "radius": 32767},
    "MODIFIER.MUTED":             {"text_color": "shade(@NEUTRAL, -5)", "image_recolor": "shade(@NEUTRAL, -5)" },
    "MODIFIER.MUTED_BG":          {"bg_color": "shade(@NEUTRAL, -5)"},
    "ANIM.HORIZONTAL":           { "anim_duration": 150 },
    "ANIM.VERTICAL":             { "anim_duration": 300 }
  }
}
