{
  "_metadata": {
    "name": "Specter",
    "version": "1.0",
    "description": "Default theme for Specter UI"
  },
  "colors": {
    "PRIMARY":    "#1F99E5",
    "SECONDARY":  "#FF7A7A",
    "TERTIARY":   "#04070B",
    "QUATERNARY": "#1E2734",
    "NEUTRAL":    "#D1D5DB",
    "SUCCESS":    "#00D100",
    "WARNING":    "#FF9A00",
    "DANGER":     "#E33630",
    "CANVAS":     "#0C1A27",
    "INK":        "#FCFCFC"
  },
  "fonts": {
    "TITLE": "montserrat:28",
    "TEXT":  "montserrat:22",
    "SMALL": "montserrat:16"
  },
  "styles": {
    "CONTAINER.SCREEN":           { "style": ["@APPEARANCE.VISIBLE", "@LAYOUT.BARE", "@BG.DARK", "@LAYOUT.FLEX_COL"], "flex_main_place": "START" },
