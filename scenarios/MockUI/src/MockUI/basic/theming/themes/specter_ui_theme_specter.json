    "CONTAINER.PIN_SCREEN":       { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL", "@LAYOUT.PARENT_WIDTH", "@LAYOUT.ALL_CENTERED"] },
