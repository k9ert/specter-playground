    "CONTAINER.MODAL_WINDOW":     { "style": ["@APPEARANCE.VISIBLE", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL", "@BG.DEFAULT", "@FG.DEFAULT"], "width": "pct(70)", "height": "SIZE_CONTENT", "border_width": 1, "radius": 20, "border_color": "@INK", "pad_all": 15, "pad_row":10 },
