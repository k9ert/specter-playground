    "TEXT.TITLE":                 { "text_font": "@TITLE"},
    "TEXT.SMALL":                 { "text_font": "@SMALL"},
    "TEXT.LEFT":                  { "text_align": "LEFT" },
    "TEXT.CENTER":                { "text_align": "CENTER" },
    "TEXT.RIGHT":                 { "text_align": "RIGHT" },
    "TEXT.BODY":                  {  },
    "LAYOUT.BARE":                { "border_width": 0, "radius": 0, "pad_all": 0 },
    "LAYOUT.BORDERLESS":          { "border_width": 0 },
    "LAYOUT.GROWS":               { "flex_grow": 1 },
    "LAYOUT.PARENT_WIDTH":        { "width": "pct(100)" },
    "LAYOUT.PARENT_HEIGHT":       { "height": "pct(100)" },
    "LAYOUT.FLEX_COL":            { "layout": "FLEX", "flex_flow": "COLUMN" },
    "LAYOUT.FLEX_ROW":            { "layout": "FLEX", "flex_flow": "ROW" }, 
