{
  "_metadata": {
    "name": "Specter",
    "version": "1.0",
    "description": "Default theme for Specter UI"
  },
  "colors": {
    "PRIMARY":    "#1F99E5",
    "SECONDARY":  "#FF7A7A",
    "TERTIARY":   "#04070B",
    "QUATERNARY": "#1E2734",
    "NEUTRAL":    "#D1D5DB",
    "SUCCESS":    "#00D100",
    "WARNING":    "#FF9A00",
    "DANGER":     "#E33630",
    "CANVAS":     "#0C1A27",
    "INK":        "#FCFCFC"
  },
  "fonts": {
    "TITLE": "montserrat:28",
    "TEXT":  "montserrat:22",
    "SMALL": "montserrat:16"
  },
  "styles": {
    "WIDGET.SCREEN":              { "style": ["@APPEARANCE.VISIBLE", "@LAYOUT.BARE", "@BG.DARK"] },
    "WIDGET.SCREEN_TITLE":        { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE", "@TEXT.CENTER"] },
    "WIDGET.OVERLAY":             { "style": ["@LAYOUT.BARE", "@BG.DARK", "@APPEARANCE.SEE_THROUGH"]},
    "WIDGET.NAVBAR":              { "style": ["@APPEARANCE.VISIBLE", "@LAYOUT.BARE", "@BG.DEFAULT"], "radius": 20, "border_width": 0,"border_color": "@INK", "clip_corner": "True"},
    "WIDGET.NAVBAR_BUTTON":       { "style": ["@APPEARANCE.TRANSPARENT"] },
    "WIDGET.NAVBAR_BUTTON_FG":    { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT"] },
    "WIDGET.MODAL_WINDOW":        { "style": ["@APPEARANCE.VISIBLE", "@BG.DEFAULT", "@FG.DEFAULT"], "border_width": 1, "radius": 20, "border_color": "@INK", "pad_all": 20 },
    "WIDGET.BUTTON":              { "style": ["@APPEARANCE.VISIBLE", "@BG.DEFAULT"], "border_width": 1, "border_color": "@INK", "radius": 20 },    
    "WIDGET.BUTTON_FG":           { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE"] },
    "WIDGET.TEXT_EDIT":           { "style": ["@APPEARANCE.VISIBLE", "@TEXT.CENTER", "@FG.DEFAULT", "@BG.DEFAULT"], "border_width": 1, "border_color": "@INK", "pad_top": 10, "pad_bottom": 10},
    "WIDGET.INFO_ITEM":           { "style": ["@APPEARANCE.TRANSPARENT", "@FG.HIGHLIGHT", "@TEXT.SMALL"], "text_align": "CENTER" },
    "WIDGET.HELP_ICON":           { "style": ["@APPEARANCE.TRANSPARENT", "@FG.LIGHT"] },
    "WIDGET.MENU_CONTAINER":      { "pad_left": 20, "pad_right": 20, "pad_row": 10 },
    "WIDGET.MENU_SECTION_HEADER": { "style": ["@APPEARANCE.TRANSPARENT", "@FG.HIGHLIGHT", "@TEXT.DEFAULT", "@TEXT.LEFT"], "pad_top": 6, "pad_bottom": 3, "pad_left": 0 },
    "WIDGET.MENU_BUTTON":         { "style": ["@APPEARANCE.VISIBLE", "@BG.DEFAULT"], "border_width": 0, "border_color": "@INK", "radius": 20 },
    "WIDGET.MENU_BUTTON_FG":      { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.DEFAULT"] },
    "WIDGET.MENU_ICON":           { "style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT"], "bg_color": "@QUATERNARY", "align": "LEFT_MID", "x": 10, "radius": 15, "border_width": 0, "width": 55, "height": 55 },
    "WIDGET.MENU_SWITCH":         { "style": ["@APPEARANCE.VISIBLE", "@BG.DEFAULT", "@FG.DEFAULT", "@TEXT.DEFAULT"], "pad_gap": 10, "pad_left": 10 },
    "WIDGET.SUBMENU_INDICATOR":   { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT"] },
    "WIDGET.DROPUP":              { "style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT", "@BG.DEFAULT", "@TEXT.TITLE"], "radius": 20 },
    "WIDGET.DROP_UP_ROW":         { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE"], "pad_left": 20, "pad_right": 20, "pad_column": 5, "pad_top": 2, "pad_bottom": 10 },
    "WIDGET.DROP_UP_ADDBTN":      { "style": ["@APPEARANCE.VISIBLE", "@BG.HIGHLIGHT"], "width":"440", "border_width": 0, "border_color": "@INK", "radius": 15, "height": 60 },
    "WIDGET.DROP_UP_ADDBTN_FG":   { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.DEFAULT"] },    
    "WIDGET.CONTEXT_BAR":         { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@FG.DEFAULT"], "pad_column": 5 },
    "WIDGET.KEYBOARD":            { "style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT", "@BG.DARK", "@TEXT.TITLE"], "border_width": 1, "border_color": "@INK", "radius": 5},
    "WIDGET.BATTERY":             {},
    "WIDGET.PIN_BUTTON":          { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BORDERLESS", "@FG.DEFAULT", "@TEXT.TITLE"] },
    "WIDGET.PIN_DISPLAY":         { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE", "@TEXT.CENTER"]},    
    "TEXT.DEFAULT":               { "text_font": "@TEXT" },
    "TEXT.TITLE":                 { "text_font": "@TITLE"},
    "TEXT.SMALL":                 { "text_font": "@SMALL"},
    "TEXT.LEFT":                  { "text_align": "LEFT" },
    "TEXT.CENTER":                { "text_align": "CENTER" },
    "TEXT.RIGHT":                 { "text_align": "RIGHT" },
    "TEXT.BODY":                  {  },
    "LAYOUT.BARE":                { "border_width": 0, "radius": 0, "pad_all": 0 },
    "LAYOUT.BORDERLESS":          { "border_width": 0 },
    "APPEARANCE.VISIBLE":         { "opa": "COVER" , "bg_opa": "COVER" },
    "APPEARANCE.TRANSPARENT":     { "opa": "COVER",  "bg_opa": "TRANSP" },
    "APPEARANCE.INVISIBLE":       { "opa": "TRANSP", "bg_opa": "TRANSP" },
    "APPEARANCE.SEE_THROUGH":     { "opa": "COVER", "bg_opa": "_70" },
    "FG.DEFAULT":                 { "text_color": "@INK", "image_recolor": "@INK"},
    "FG.SUCCESS":                 { "text_color": "@SUCCESS", "image_recolor": "@SUCCESS"},
    "FG.WARNING":                 { "text_color": "@WARNING", "image_recolor": "@WARNING"},
    "FG.DANGER":                  { "text_color": "@DANGER", "image_recolor": "@DANGER"},
    "FG.HIGHLIGHT":               { "text_color": "@PRIMARY", "image_recolor": "@PRIMARY"},
    "FG.LIGHT":                   { "text_color": "@NEUTRAL", "image_recolor": "@NEUTRAL"},
    "FG.DARK":                    { "text_color": "@TERTIARY", "image_recolor": "@TERTIARY"},
    "BG.DEFAULT":                 { "bg_color": "@CANVAS"},
    "BG.SUCCESS":                 { "bg_color": "@SUCCESS"},
    "BG.WARNING":                 { "bg_color": "@WARNING"},
    "BG.DANGER":                  { "bg_color": "@DANGER"},
    "BG.HIGHLIGHT":               { "bg_color": "@PRIMARY"},
    "BG.LIGHT":                   { "bg_color": "@NEUTRAL"},
    "BG.DARK":                    { "bg_color": "@TERTIARY"},
    "BORDER.TOP":                 { "border_width": 0, "border_side": "TOP",    "border_color": "@NEUTRAL" },
    "BORDER.BOTTOM":              { "border_width": 0, "border_side": "BOTTOM", "border_color": "@NEUTRAL" },
    "BORDER.LEFT":                { "border_width": 0, "border_side": "LEFT",   "border_color": "@NEUTRAL" },
    "BORDER.RIGHT":               { "border_width": 0, "border_side": "RIGHT",  "border_color": "@NEUTRAL" },
    "CONTEXT.SEED":               {},
    "CONTEXT.WALLET":             {},
    "CONTEXT.MAIN":               {},
    "CONTEXT.SETTINGS":           {},
    "SLIDER.TRACK":               {"style": ["@APPEARANCE.VISIBLE", "@BG.DARK"], "pad_all": 0, "radius": 32767},
    "SLIDER.INDICATOR":           {"style": ["@APPEARANCE.VISIBLE", "@BG.WARNING"], "pad_all": 0, "radius": 32767},
    "SLIDER.KNOB":                {"style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT"], "pad_all": -3, "radius": 32767},
    "SWITCH.TRACK":               {"style": ["@APPEARANCE.VISIBLE", "@BG.DARK"], "pad_all": 0, "radius": 32767},
    "SWITCH.INDICATOR":           {"style": ["@APPEARANCE.VISIBLE", "@BG.DARK"], "pad_all": 0, "radius": 32767},
    "SWITCH.KNOB":                {"style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT"], "pad_all": -3, "radius": 32767},
    "MODIFIER.MUTED":             {"text_color": "shade(@NEUTRAL, -5)", "image_recolor": "shade(@NEUTRAL, -5)" }
  }
}
