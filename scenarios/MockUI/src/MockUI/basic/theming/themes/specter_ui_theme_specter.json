    "CONTAINER.CONTENT":          { "style": ["@APPEARANCE.VISIBLE", "@BG.DARK", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL", "@LAYOUT.START", "@LAYOUT.GROWS", "@LAYOUT.PARENT_WIDTH"]},
    "CONTAINER.TITLED_SCREEN":    { "style": ["@APPEARANCE.TRANSPARENT", "@BG.DEFAULT", "@LAYOUT.BARE", "@LAYOUT.FLEX_COL", "@LAYOUT.START", "@LAYOUT.GROWS", "@LAYOUT.PARENT_WIDTH"]},
    "CONTAINER.TITLE_BAR":        { "style": ["@APPEARANCE.VISIBLE", "@BG.DARK", "@LAYOUT.BARE", "@LAYOUT.FLEX_ROW", "@LAYOUT.PARENT_WIDTH", "@LAYOUT.ALL_CENTERED"], "height": "pct(8)"},
    "CONTAINER.MENU_CONTAINER":   { "style": ["@LAYOUT.FLEX_COL", "@LAYOUT.START", "@LAYOUT.GROWS", "@LAYOUT.BARE"], "pad_left": 10, "pad_right": 10, "pad_row": 10, "pad_bottom": 10},
    "CONTAINER.MENU_ROW":         { "style": ["@LAYOUT.BARE", "@LAYOUT.FLEX_ROW", "@LAYOUT.START", "@LAYOUT.PARENT_WIDTH"], "height": "SIZE_CONTENT", "pad_left": 0, "pad_right": 0, "pad_column": 10 },
    "CONTAINER.MENU_BUTTON_RHS":  { "style": ["@LAYOUT.BARE", "@LAYOUT.FLEX_ROW"], "width": "SIZE_CONTENT", "height": "SIZE_CONTENT", "flex_cross_place": "CENTER", "pad_left": 0, "pad_right": 0, "pad_column": 10 },
    "CONTAINER.MAIN_MENU":        {},
