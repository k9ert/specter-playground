{
  "_metadata": {
    "name": "Specter",
    "version": "1.0",
    "description": "Default theme for Specter UI"
  },
  "colors": {
    "primary":    "#f7931a",
    "secondary":  { "dark": "#1e2a45", "light": "#dce8ff" },
    "tertiary":   "#26a69a",
    "quaternary": "#9c27b0",
    "neutral":    "#777777",
    "success":    "#00D100",
    "warning":    "#FF9A00",
    "danger":     "#F10000",
    "canvas":    { "dark": "#282B30", "light": "#FFFFFF" },
    "ink":       { "dark": "#FFFFFF", "light": "#111111" }
  },
  "fonts": {
    "title": "montserrat:28",
    "text":  "montserrat:22",
    "small": "montserrat:16"
  },
  "styles": {
    "WIDGET.SCREEN":              { "style": ["@APPEARANCE.VISIBLE", "@LAYOUT.BARE", "@BG.DEFAULT"] },
    "WIDGET.SCREEN_TITLE":        { "style": ["@APPEARANCE.TRANSPARENT", "@FG.HIGHLIGHT", "@TEXT.TITLE"] },
    "WIDGET.OVERLAY":             { "style": ["@APPEARANCE.SEE_THROUGH", "@LAYOUT.BARE", "@BG.DARK"] },
    "WIDGET.NAVBAR":              { "style": ["@APPEARANCE.VISIBLE", "@LAYOUT.BARE"], "bg_color": "@secondary" },
    "WIDGET.NAVBAR_BUTTON":       { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT"] },
    "WIDGET.MODAL_WINDOW":        { "style": ["@APPEARANCE.VISIBLE", "@BG.DARK", "@FG.DEFAULT"] },
    "WIDGET.BUTTON":              { "style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT", "@BG.DEFAULT"], "border_width": 1, "border_color": "@ink", "radius": 5 },
    "WIDGET.TEXT_EDIT":           { "border_width": 1, "border_color": "@ink", "text_font": "@title" },
    "WIDGET.INFO_ITEM":           { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.SMALL"] },
    "WIDGET.HELP_ICON":           { "style": ["@APPEARANCE.TRANSPARENT", "@FG.LIGHT"] },
    "WIDGET.MENU_SECTION_HEADER": { "style": ["@APPEARANCE.TRANSPARENT", "@FG.HIGHLIGHT", "@TEXT.TITLE"] },
    "WIDGET.MENU_BUTTON":         { "style": ["@APPEARANCE.VISIBLE", "@FG.HIGHLIGHT", "@BG.DEFAULT"], "radius": 20 },
    "WIDGET.MENU_ICON":           { "style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT", "@BG.DEFAULT"], "radius": 10, "border_width": 1 },
    "WIDGET.MENU_BUTTON_LABEL":   { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE"] },
    "WIDGET.MENU_SWITCH":         { "style": ["@APPEARANCE.VISIBLE", "@FG.DEFAULT", "@TEXT.DEFAULT"] },
    "WIDGET.SUBMENU_INDICATOR":   { "style": ["@APPEARANCE.TRANSPARENT", "@FG.WARNING"] },
    "WIDGET.DROPUP":              { "style": ["@APPEARANCE.VISIBLE", "@BG.DARK", "@TEXT.DEFAULT"] },
    "WIDGET.DROP_UP_ROW":         { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.DEFAULT"] },
    "WIDGET.DROP_UP_ADDBTN":      { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE"] },
    "WIDGET.CONTEXT_BAR":         { "style": ["@APPEARANCE.TRANSPARENT", "@LAYOUT.BARE", "@FG.DEFAULT"] },
    "WIDGET.KEYBOARD":            { "style": ["@FG.DEFAULT", "@TEXT.TITLE"] },
    "WIDGET.BATTERY":             {},
    "WIDGET.PIN_BUTTON":          { "style": ["@APPEARANCE.TRANSPARENT", "@FG.DEFAULT", "@TEXT.TITLE"] },
    "TEXT.DEFAULT":               { "text_font": "@text" },
    "TEXT.TITLE":                 { "text_font": "@title"},
    "TEXT.SMALL":                 { "text_font": "@small"},
    "TEXT.BODY":                  {  },
    "LAYOUT.BARE":                { "border_width": 0, "radius": 0, "pad_all": 0},
    "APPEARANCE.VISIBLE":         { "opa": "COVER" , "bg_opa": "COVER" },
    "APPEARANCE.TRANSPARENT":     { "opa": "COVER",  "bg_opa": "TRANSP" },
    "APPEARANCE.INVISIBLE":       { "opa": "TRANSP", "bg_opa": "TRANSP" },
    "APPEARANCE.SEE_THROUGH":     { "opa": "_50",    "bg_opa": "_50" },
    "FG.DEFAULT":                 { "text_color": "@ink", "image_recolor": "@ink", "opa": "COVER"},
    "FG.SUCCESS":                 { "text_color": "@success", "image_recolor": "@success", "opa": "COVER"},
    "FG.WARNING":                 { "text_color": "@warning", "image_recolor": "@warning", "opa": "COVER"},
    "FG.DANGER":                  { "text_color": "@danger", "image_recolor": "@danger", "opa": "COVER"},
    "FG.HIGHLIGHT":               { "text_color": "@primary", "image_recolor": "@primary", "opa": "COVER"},
    "FG.LIGHT":                   { "text_color": "shade(@neutral,  6)", "image_recolor": "shade(@neutral,  6)", "opa": "COVER"},
    "FG.DARK":                    { "text_color": "shade(@neutral, -6)", "image_recolor": "shade(@neutral, -6)", "opa": "COVER"},
    "BG.DEFAULT":                 { "bg_color": "@canvas", "bg_opa": "COVER" },
    "BG.SUCCESS":                 { "bg_color": "@success", "bg_opa": "COVER" },
    "BG.WARNING":                 { "bg_color": "@warning", "bg_opa": "COVER" },
    "BG.DANGER":                  { "bg_color": "@danger", "bg_opa": "COVER" },
    "BG.HIGHLIGHT":               { "bg_color": "@primary", "bg_opa": "COVER" },
    "BG.LIGHT":                   { "bg_color": "shade(@neutral,  6)", "bg_opa": "COVER" },
    "BG.DARK":                    { "bg_color": "shade(@neutral, -6)", "bg_opa": "COVER" },
    "BORDER.TOP":                 { "border_width": 1, "border_side": "TOP",    "border_color": "@ink" },
    "BORDER.BOTTOM":              { "border_width": 1, "border_side": "BOTTOM", "border_color": "@ink" },
    "BORDER.LEFT":                { "border_width": 1, "border_side": "LEFT",   "border_color": "@ink" },
    "BORDER.RIGHT":               { "border_width": 1, "border_side": "RIGHT",  "border_color": "@ink" },
    "CONTEXT.SEED":               {},
    "CONTEXT.WALLET":             {},
    "CONTEXT.MAIN":               {},
    "CONTEXT.SETTINGS":           {},
    "SLIDER.TRACK":               {},
    "SLIDER.INDICATOR":           {},
    "SLIDER.KNOB":                {"bg_color": "@ink", "bg_opa": "COVER", "pad_all": 0},
    "MODIFIER.MUTED":             {"bg_color": "@neutral", "text_color": "@neutral", "image_recolor": "@neutral" }
  }
}
